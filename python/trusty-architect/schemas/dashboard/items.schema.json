{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dashboard/items.schema.json",
  "title": "item (decision D, ask A, task T, request R)",
  "type": "object",
  "$defs": {
    "iso": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{3})?Z$"},
    "isoOrDate": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{3})?Z)?$"},
    "runTime": {"type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])(T([01][0-9]|2[0-3]):[0-5][0-9](:[0-5][0-9])?Z)?$"},
    "runLogEntry": {"type": "object", "required": ["at"], "additionalProperties": false,
                    "properties": {"at": {"$ref": "#/$defs/runTime"}, "note": {"type": "string"},
                                   "duration_s": {"type": "integer", "minimum": 0}}},
    "isoOrNull": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/iso"}]},
    "link": {"type": "object", "required": ["label", "url"], "additionalProperties": false,
             "properties": {"label": {"type": "string"}, "url": {"type": "string"}}},
    "itemLink": {"oneOf": [{"type": "string"},
                           {"type": "object", "required": ["label"], "additionalProperties": false,
                            "properties": {"label": {"type": "string"}, "item": {"type": "string"}, "url": {"type": "string"}}}]},
    "marker": {"type": "integer", "minimum": -3, "maximum": 3},
    "req": {"oneOf": [{"type": "null"},
                      {"type": "object", "required": ["at"], "additionalProperties": false,
                       "properties": {"at": {"$ref": "#/$defs/iso"}, "by": {"type": "string"}}}]},
    "option": {"type": "object", "required": ["label", "desc"], "additionalProperties": false,
               "properties": {"label": {"type": "string"}, "desc": {"type": "string"}, "recommended": {"type": "boolean"},
                              "markers": {"type": "object", "additionalProperties": false,
                                          "properties": {"work": {"$ref": "#/$defs/marker"}, "scope": {"$ref": "#/$defs/marker"}, "risk": {"$ref": "#/$defs/marker"}}}}},
    "step": {"type": "object", "required": ["title"], "additionalProperties": false,
             "properties": {"id": {"type": "string"}, "title": {"type": "string", "minLength": 1}, "detail": {"type": "string"},
                            "links": {"type": "array", "items": {"$ref": "#/$defs/link"}},
                            "values": {"type": "array", "items": {"type": "string"}},
                            "done": {"type": "boolean"}, "optional": {"type": "boolean"}}},
    "parked": {"oneOf": [{"type": "null"},
                         {"type": "object", "required": ["choice", "at", "by"], "additionalProperties": false,
                          "properties": {"choice": {"enum": ["tomorrow", "nextweek", "owner", "stale", "clarify"]},
                                         "until": {"$ref": "#/$defs/isoOrNull"}, "at": {"$ref": "#/$defs/iso"}, "by": {"type": "string"},
                                         "reason": {"type": "string"}, "relayed_at": {"$ref": "#/$defs/iso"},
                                         "clarify": {"type": "object", "additionalProperties": false,
                                                     "properties": {"dimension": {"enum": ["work", "scope", "risk", "general"]},
                                                                    "option": {"type": ["string", "null"]}}}}}]},
    "wont_do_entry": {"type": "object", "required": ["at"], "additionalProperties": false,
                      "properties": {"at": {"$ref": "#/$defs/iso"}, "by": {"type": "string"}, "attempts": {"type": "integer", "minimum": 1},
                                     "note": {"type": "string"}}}
  },
  "required": ["kind", "status", "title", "session", "goal", "rank", "created", "updated"],
  "additionalProperties": false,
  "properties": {
    "kind": {"enum": ["question", "action", "task"]},
    "status": {"enum": ["open", "answered", "done", "wont_do", "cancelled"]},
    "title": {"type": "string", "minLength": 1},
    "detail": {"type": "string"}, "detail_note": {"type": "string"}, "detail_ref": {"type": "string"},
    "doc": {"type": "string", "pattern": "^[^/]+/docs/briefs/.+[.]md$"},
    "brief": {"type": "string", "pattern": "^[^/]+/docs/briefs/.+[.]md$"},
    "brief_request": {"$ref": "#/$defs/req"},
    "session": {"type": "string"},
    "goal": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^G[0-9a-f]{2}$"}]},
    "goal_legacy": {"oneOf": [{"type": "null"}, {"type": "string", "minLength": 1}]},
    "rank": {"type": "integer"},
    "urgent": {"type": "boolean"}, "blocks_session": {"type": "boolean"},
    "due": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/isoOrDate"}]},
    "created": {"$ref": "#/$defs/iso"}, "updated": {"$ref": "#/$defs/iso"}, "done_at": {"$ref": "#/$defs/iso"}, "done_by": {"type": "string"},
    "outcome": {"type": "string"},
    "run_start": {"$ref": "#/$defs/runTime"}, "run_end": {"$ref": "#/$defs/runTime"},
    "run_schedule": {"type": "array", "items": {"$ref": "#/$defs/runTime"}},
    "run_log": {"type": "array", "items": {"$ref": "#/$defs/runLogEntry"}},
    "options": {"type": "array", "items": {"$ref": "#/$defs/option"}},
    "specs": {"type": "array", "items": {"$ref": "#/$defs/link"}},
    "links": {"type": "array", "items": {"$ref": "#/$defs/itemLink"}},
    "steps": {"type": "array", "items": {"$ref": "#/$defs/step"}},
    "plan": {"type": "array", "items": {"type": "object", "required": ["title"], "additionalProperties": false,
                                        "properties": {"title": {"type": "string"}, "detail": {"type": "string"}}}},
    "plan_title": {"type": "string"},
    "answer": {"type": ["string", "null"]}, "answer_note": {"type": "string"},
    "answered_at": {"$ref": "#/$defs/isoOrNull"}, "owner_note": {"type": "string"},
    "cancelled_at": {"$ref": "#/$defs/iso"}, "cancelled_by": {"type": "string"}, "cancel_note": {"type": "string"},
    "parked": {"$ref": "#/$defs/parked"},
    "resume_request": {"$ref": "#/$defs/req"}, "status_request": {"$ref": "#/$defs/req"},
    "status_note": {"type": "string"}, "status_at": {"$ref": "#/$defs/iso"},
    "steer_requests": {"type": "array", "items": {"type": "object", "required": ["text", "at", "by"], "additionalProperties": false,
                                                  "properties": {"text": {"type": "string"}, "at": {"$ref": "#/$defs/iso"}, "by": {"type": "string"},
                                                                 "relayed_at": {"$ref": "#/$defs/iso"}}}},
    "updates": {"type": "array", "items": {"type": "object", "required": ["at", "text"], "additionalProperties": false,
                                           "properties": {"at": {"$ref": "#/$defs/iso"}, "by": {"type": "string"}, "text": {"type": "string"}}}},
    "progress": {"type": "object", "required": ["pct", "estimated_at"], "additionalProperties": false,
                 "properties": {"pct": {"type": "integer", "minimum": 0, "maximum": 100}, "eta": {"$ref": "#/$defs/iso"},
                                "eta_low": {"$ref": "#/$defs/iso"}, "eta_high": {"$ref": "#/$defs/iso"},
                                "confidence": {"enum": ["low", "medium", "high"]}, "basis": {"type": "string"},
                                "estimated_at": {"$ref": "#/$defs/iso"}}},
    "feedback": {"type": "object", "required": ["at", "by", "note"], "additionalProperties": false,
                 "properties": {"at": {"$ref": "#/$defs/iso"}, "by": {"type": "string"}, "note": {"type": "string"},
                                "reply": {"type": "string"}, "reply_at": {"$ref": "#/$defs/iso"},
                                "status": {"enum": ["new", "handled", "answered"]}, "to": {"type": "string"}}},
    "wont_do": {"$ref": "#/$defs/wont_do_entry"},
    "wont_do_history": {"type": "array", "items": {"$ref": "#/$defs/wont_do_entry"}}
  }
}
