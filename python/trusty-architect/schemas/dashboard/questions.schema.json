{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dashboard/questions.schema.json",
  "title": "question (the Architect's answer to an owner question, kept until the owner clears it)",
  "type": "object",
  "$defs": {
    "iso": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{3})?Z$"},
    "iso_or_empty": {"type": "string", "pattern": "^([0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{3})?Z)?$"}
  },
  "required": ["asked", "answer", "status", "answered_at", "updated"],
  "additionalProperties": false,
  "properties": {
    "asked": {"type": "string", "minLength": 1},
    "asked_at": {"$ref": "#/$defs/iso_or_empty"},
    "answer": {"type": "string"},
    "links": {"type": "array", "items": {"type": "object", "required": ["label", "url"], "additionalProperties": false,
      "properties": {"label": {"type": "string", "minLength": 1}, "url": {"type": "string", "pattern": "^https?://"}}}},
    "brief": {"type": "string", "pattern": "^[^/]+/docs/briefs/.+[.]md$"},
    "session": {"type": "string"},
    "status": {"enum": ["open", "cleared"]},
    "answered_at": {"$ref": "#/$defs/iso"},
    "cleared_at": {"$ref": "#/$defs/iso_or_empty"},
    "updated": {"$ref": "#/$defs/iso"}
  }
}
