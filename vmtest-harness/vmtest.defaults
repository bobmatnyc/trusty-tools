# vmtest-harness project defaults.
# Format: key<TAB>value. '#' comments and blank lines ignored. Unknown keys are an error.
# Override per-host with the matching VMTEST_* environment variable; never edit this
# file to suit one machine.

# --- guest sizing (DOC-1 §8.5; measured at vm-install-probe-findings.md:841-843) ---
cpu	8
memory_mib	16384
disk_gib	100

# --- guest paths (measured: vm-install-probe-findings.md:139) ---
guest_home	/Users/admin
guest_src_dir	/Users/admin/vmtest-src
guest_target_dir	/Users/admin/vmtest-target

# --- host capacity preflight (DOC-1 §4.1 gap; see §8.4) ---
host_min_memory_gib	24
host_warn_physical_cores	8

# --- polling and watchdogs, seconds (see §10) ---
boot_ready_timeout	150
boot_ready_interval	2
stopped_timeout	120
stopped_interval	1
provision_timeout	300
# install_timeout is the FULL-STACK SCENARIO budget despite its name (DOC-2
# §10.2); the single-crate install budget is a different site, 900 s, built in.
# TIGHTENED 2700 -> 1800 at plan P5-T8, on the first real measurement rather
# than on DOC-1 §9's 4-8 min extrapolation, which it supersedes. Two pattern-(c)
# full-stack runs on 2026-08-02 measured the SCENARIO at 640 s and 748 s
# (8 crates, 13 binaries, shared CARGO_TARGET_DIR). 1800 s is ~2.4x the slower
# of the two. §10.2's constraint is why the headroom stays generous: a tight
# timeout does not enforce a budget, it manufactures flaky failures that get
# "fixed" by raising it. What changed is that the multiple now sits over a
# MEASUREMENT instead of over an estimate labelled low-confidence.
install_timeout	1800
health_timeout	60
health_interval	1

# --- source (DOC-1 §6.2) ---
repo_url	https://github.com/bobmatnyc/trusty-tools.git
default_branch	main
