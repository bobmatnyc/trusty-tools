{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "async": true,
            "command": "/Users/masa/.cargo/bin/trusty-mpm hook",
            "timeout": 60,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "/Users/masa/.cargo/bin/tm hook --pm-guard",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": ""
      },
      {
        "hooks": [
          {
            "command": "/Users/masa/.cargo/bin/trusty-mpm hook",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "/Users/masa/.cargo/bin/trusty-mpm hook",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "trusty-memory inbox-check",
            "timeout": 60,
            "type": "command"
          }
        ],
        "matcher": ""
      },
      {
        "hooks": [
          {
            "command": "/Users/masa/.cargo/bin/trusty-mpm hook",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "/Users/masa/.cargo/bin/trusty-mpm hook",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "command": "/Users/masa/.cargo/bin/trusty-mpm hook",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "trusty-memory prompt-context",
            "timeout": 60,
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ]
  },
  "outputStyle": "trusty-mpm",
  "spinnerTipsEnabled": true,
  "spinnerTipsOverride": {
    "tips": [
      "tm launch — start a configured claude session for this project",
      "make check = cargo test + clippy + fmt — must pass before any PR",
      "API → CLI → TUI: implement at the lowest layer first",
      "Delegate Rust code to rust-engineer — PM never edits .rs files",
      "gh issue create to track work; commits include Closes #N",
      "tmux ls shows all active tm-<project>-NN sessions",
      "tm session list shows daemon-managed sessions",
      "/compact at ~50% context to stay focused",
      "Layer new features behind the HTTP API before wiring CLI or TUI"
    ]
  },
  "statusLine": {
    "command": "/Users/masa/.cargo/bin/tm statusline",
    "padding": 0,
    "type": "command"
  }
}