{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dashboard/meta-seen.schema.json",
  "title": "meta/seen (decision signatures the owner has seen; value is the page's signature string, or a list of them)",
  "type": "object",
  "$defs": {
    "iso": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{3})?Z$"}
  },
  "required": ["map"],
  "additionalProperties": false,
  "properties": {
    "map": {"type": "object",
            "additionalProperties": {"oneOf": [{"type": "string"}, {"type": "array", "items": {"type": "string"}}]}},
    "updated": {"$ref": "#/$defs/iso"}
  }
}
