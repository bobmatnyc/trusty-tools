{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dashboard/effort_tunes.schema.json",
  "title": "effort tune (More/Less Effort on a goal); no documents today",
  "type": "object",
  "$defs": {
    "iso": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{3})?Z$"}
  },
  "required": ["status", "at", "goal", "direction"],
  "additionalProperties": false,
  "properties": {
    "status": {"enum": ["new", "applied"]},
    "at": {"$ref": "#/$defs/iso"},
    "goal": {"type": "string"},
    "direction": {"type": "string"},
    "bias_after": {"type": "integer"}
  }
}
