{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dashboard/goal_removals.schema.json",
  "title": "goal removal request (owner)",
  "type": "object",
  "$defs": {
    "iso": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{3})?Z$"}
  },
  "required": ["goal", "title", "by", "created", "status"],
  "additionalProperties": false,
  "properties": {
    "goal": {"type": "string", "pattern": "^G[0-9a-f]{2}$"},
    "title": {"type": "string"},
    "by": {"type": "string"},
    "created": {"$ref": "#/$defs/iso"},
    "status": {"enum": ["new", "handled"]}
  }
}
