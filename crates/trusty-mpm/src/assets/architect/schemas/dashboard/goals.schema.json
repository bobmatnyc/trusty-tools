{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dashboard/goals.schema.json",
  "title": "goal (G); a factory goal also needs board {label,url} (checked in dashboard_schema invariants)",
  "type": "object",
  "$defs": {
    "iso": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{3})?Z$"},
    "isoOrNull": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/iso"}]}
  },
  "required": ["kind", "rank", "title", "lifecycle", "updated"],
  "additionalProperties": false,
  "properties": {
    "kind": {"enum": ["standing", "directed", "factory"]},
    "board": {"type": "object", "required": ["label", "url"], "additionalProperties": false,
              "properties": {"label": {"type": "string"}, "url": {"type": "string"}}},
    "repo": {"type": "string", "pattern": "^[^/ ,]+/[^/ ,]+(, [^/ ,]+/[^/ ,]+)*$"},
    "created": {"$ref": "#/$defs/iso"},
    "rank": {"type": "integer"},
    "title": {"type": "string", "minLength": 1},
    "lifecycle": {"enum": ["active", "parked", "done", "removed"]},
    "status_line": {"type": "string"},
    "updated": {"$ref": "#/$defs/iso"},
    "finish_line": {"type": "string"},
    "next_milestone": {"type": "string"},
    "sessions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "rank_set_at": {"$ref": "#/$defs/iso"}, "rank_set_by": {"type": "string"},
    "removed_at": {"$ref": "#/$defs/iso"},
    "parked": {"oneOf": [{"type": "null"},
                         {"type": "object", "required": ["choice", "at", "by"], "additionalProperties": false,
                          "properties": {"until": {"$ref": "#/$defs/isoOrNull"}, "choice": {"const": "owner"},
                                         "at": {"$ref": "#/$defs/iso"}, "by": {"type": "string"}}}]},
    "park_ack": {"$ref": "#/$defs/isoOrNull"},
    "unparked_at": {"$ref": "#/$defs/iso"}, "unparked_by": {"type": "string"},
    "done_at": {"$ref": "#/$defs/iso"}, "done_by": {"type": "string"}, "done_note": {"type": "string"}, "done_ack": {"$ref": "#/$defs/isoOrNull"},
    "reopened_at": {"$ref": "#/$defs/iso"}, "reopened_by": {"type": "string"}
  }
}
