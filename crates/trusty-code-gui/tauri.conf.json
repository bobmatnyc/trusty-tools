{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Trusty Code",
  "mainBinaryName": "Trusty Code",
  "version": "0.1.0",
  "identifier": "com.trusty.trusty-code.gui",
  "build": {
    "frontendDist": "ui/dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "cd ui && pnpm dev",
    "beforeBuildCommand": "cd ui && pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Trusty Code",
        "width": 1280,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "Developer ID Application: Bob Matsuoka (4JH68XUHC5)"
    }
  }
}
