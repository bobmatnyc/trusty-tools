{
  "version": 2,
  "argv": [
    "event.json"
  ],
  "stdin": "",
  "env": {},
  "files": {
    "event.json": "{\"kind\": \"status\", \"repo\": \"example-org/example-repo\", \"claims\": {\"issues\": [{\"n\": 5, \"state\": \"closed\", \"reason\": \"Completed\"}, {\"n\": 6, \"state\": \"OPEN\"}]}}\n",
    "local/architect.json": "{\n  \"repos\": {\n    \"example-repo\": {\n      \"slug\": \"example-org/example-repo\",\n      \"gh_config_dir\": \"gh/example-org\",\n      \"checkout\": \"work/example-repo\"\n    },\n    \"second\": {\n      \"slug\": \"example-two/second\"\n    }\n  }\n}\n",
    "work/example-repo/README.md": "sample checkout\n"
  },
  "reads": [
    "event.json",
    "local/architect.json"
  ],
  "stdout": "MATCH issue 5 state CLOSED\nMATCH issue 5 state_reason Completed\nMATCH issue 6 state OPEN\n",
  "stderr": "",
  "exit": 0,
  "writes": {},
  "fakes": {
    "stubs": {
      "gh": [
        {
          "argv": [
            "api",
            "repos/example-org/example-repo/issues/5"
          ],
          "stdout": "{\"state\": \"closed\", \"state_reason\": \"completed\"}",
          "stderr": "",
          "exit": 0
        },
        {
          "argv": [
            "api",
            "repos/example-org/example-repo/issues/6"
          ],
          "stdout": "{\"state\": \"open\", \"state_reason\": null}",
          "stderr": "",
          "exit": 0
        }
      ]
    },
    "calls": [
      [
        "gh",
        "api",
        "repos/example-org/example-repo/issues/5"
      ],
      [
        "gh",
        "api",
        "repos/example-org/example-repo/issues/6"
      ]
    ]
  }
}
