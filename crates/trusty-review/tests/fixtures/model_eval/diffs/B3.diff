+//! Shorten labels for the status bar.
+
+/// `s` cut to at most `max` characters, with an ellipsis when cut.
+pub fn elide_chars(s: &str, max: usize) -> String {
+    if s.chars().count() <= max {
+        return s.to_string();
+    }
+    format!("{}…", &s[..max])
+}
