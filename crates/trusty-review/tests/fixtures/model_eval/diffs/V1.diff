+//! Keep file reads inside the repository root.
+
+use std::path::Path;
+
+/// Whether `candidate` lies inside `root`. Both are already canonical.
+pub fn is_inside_root(root: &Path, candidate: &Path) -> bool {
+    let root = root.to_string_lossy();
+    let candidate = candidate.to_string_lossy();
+    candidate.starts_with(root.as_ref())
+}
