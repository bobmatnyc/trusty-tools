+//! The newest session snapshot.
+
+/// The newest of `stamps` (RFC 3339 strings sort chronologically), or
+/// `None` when there is none.
+pub fn latest(stamps: &[String]) -> Option<&String> {
+    if stamps.is_empty() {
+        return None;
+    }
+    let newest = stamps.iter().max().expect("non-empty: checked above");
+    Some(newest)
+}
