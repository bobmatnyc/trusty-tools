+//! Recall returns newer drawers first when scores tie.
+
+#[test]
+fn ties_sort_newest_first() {
+    let mut drawers = vec![(0.5_f32, 1_u64), (0.5, 3), (0.5, 2)];
+    drawers.sort_by(|a, b| b.0.total_cmp(&a.0).then(b.1.cmp(&a.1)));
+    assert_eq!(drawers.iter().map(|d| d.1).collect::<Vec<_>>(), vec![3, 2, 1]);
+}
