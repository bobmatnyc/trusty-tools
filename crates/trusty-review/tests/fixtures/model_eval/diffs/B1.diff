+//! Paging over catch-up items.
+
+/// One page of `items`, `limit` long, starting at `offset`.
+pub fn page<T: Clone>(items: &[T], offset: usize, limit: usize) -> Vec<T> {
+    if offset >= items.len() {
+        return Vec::new();
+    }
+    items[offset..offset + limit].to_vec()
+}
