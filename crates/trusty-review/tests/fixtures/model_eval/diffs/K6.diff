+//! Token budget arithmetic.
+
+/// Tokens left of `budget` after `used`; zero when over.
+pub fn remaining(budget: u64, used: u64) -> u64 {
+    budget.saturating_sub(used)
+}
+
+/// Percent of `budget` used, 0-100.
+pub fn percent_used(budget: u64, used: u64) -> u8 {
+    if budget == 0 {
+        return 100;
+    }
+    let pct = used.min(budget) * 100 / budget;
+    pct as u8
+}
