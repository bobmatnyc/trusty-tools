{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Trusty Audit",
  "version": "0.1.0",
  "identifier": "com.trusty.audit",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:5183",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    },
    "windows": [
      {
        "label": "main",
        "title": "Trusty Audit",
        "width": 860,
        "height": 700,
        "minWidth": 640,
        "minHeight": 480
      }
    ]
  },
  "bundle": {
    "active": false
  }
}
